COMMON_APP_NAME = Passager
COMMON_ORGANIZATION_NAME = your_org_name_or_your_real_name
COMMON_MONGODB_CONNECTION_STRING = connection_string_with_username_and_password
COMMON_TOKEN_SECRET= your_secret_token_goes_here
COMMON_MONGODB_DATABASE = passAuthentication

AUTH_PUBLIC_URL = Public url for the authentication service (i.e. http://localhost:3001/)
AUTH_COLLECTION = emailVerification
AUTH_PORT = 3001
AUTH_SMTP_HOST = smtpHost.com
AUTH_SMTP_PORT = 2525
AUTH_SMTP_USER = user
AUTH_SMTP_PASSWORD = password
AUTH_SMTP_SENDER = sendFrom
AUTH_LIMIT_ACCESS_BY_EMAIL = If true, the system will deny login for users with a non-authorized e-mail (e.g. true). IMPORTANT: any non-empty value enables it, even false. Leave it empty to allow any e-mail
AUTH_ALLOWED_DOMAINS = This will not have effect if AUTH_LIMIT_ACCESS_BY_EMAIL is false. Only e-mails belonging to domains specified here will be able to login (e.g. myorg.com, gmail.com, outlook.com) 
AUTH_ALLOWED_EMAILS = This will not have effect if AUTH_LIMIT_ACCESS_BY_EMAIL is false. Specific e-mails that will be able to login even if they don not belong to a valid domain (e.g. test@test.com, test2@test2.com, test3@test3.com)

DOCS_PUBLIC_URL = Public url for the documents service (i.e. http://localhost:3002/)
DOCS_PORT = 3002

# Optional settings
# AUTH_LIMIT_ATTEMPTS_PER_IP = Maximum number of login attempts by IP address before having to wait (e.g. 5). Not limited if it is not defined. The authentication service must be behind a proxy that sets the X-Forwarded-For header
# AUTH_LIMIT_ATTEMPTS_PER_IP_WAIT_TIME = Milliseconds an IP address has to wait once it reaches the limit (e.g. 600000)
# HTML_EMAIL_TEMPLATE = HTML to send as login e-mail instead of the default text. [code] is replaced by the login code
DOCS_MAX_FILE_BYTES = Optional. Largest file users can store, in bytes (default 52428800, which is 50 MB)
