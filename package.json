{
    "name": "passager-password-manager",
    "version": "2.0.0",
    "private": true,
    "license": "AGPL-3.0",
    "type": "module",
    "packageManager": "pnpm@11.1.2",
    "engines": {
        "node": "22.x",
        "pnpm": ">=11"
    },
    "dependencies": {
        "@emotion/is-prop-valid": "^1.4.0",
        "@mdi/js": "^7.4.47",
        "i18next": "^27.1.1",
        "prop-types": "^15.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.1",
        "react-qr-code": "^2.2.0",
        "react-router-dom": "^7.18.5",
        "styled-components": "^6.6.0"
    },
    "scripts": {
        "start": "vite",
        "start:docker": "docker run -p 8000:80 passager-frontend",
        "start:docker:dev": "docker run -p 3000:3000 --mount src=`pwd`/src,target=/usr/src/app/src,type=bind passager-frontend-dev",
        "build": "vite build && node bin/postbuild.js",
        "build:web": "pnpm run build",
        "build:docker": "docker build . -t 'passager-frontend'",
        "build:docker:dev": "docker build . -t 'passager-frontend-dev' -f Dockerfile.dev",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky",
        "lint": "eslint . --fix --max-warnings=0",
        "format": "prettier . --write"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.10",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.1",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    },
    "lint-staged": {
        "*.{js,jsx}": "eslint --fix",
        "*.{css,md,json}": "prettier --cache --write"
    }
}
